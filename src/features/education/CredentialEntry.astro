---
import type { Credential, Locale } from "../../content/types";
import { formatDate } from "../../lib/locale";
import Icon from "../../components/ui/Icon.astro";
import ExternalLink from "../../components/ui/ExternalLink.astro";
import { credentialPreview } from "./previews";
interface Props {
  credential: Credential;
  locale: Locale;
}
const { credential, locale } = Astro.props;
const preview = await credentialPreview(credential.id);
const words = credential.name.split(" ");
const lastWord = words.pop();
const beginning = words.join(" ");
---

<li>
  <div>
    <h4>
      <ExternalLink class="credential" href={credential.href} data-certificate-preview={preview}>
        <span class="link-label">{beginning}</span>{" "}
        <span class="credential-tail">
          <span class="link-label">{lastWord}</span>
          <Icon name="external" />
        </span>
      </ExternalLink>
    </h4>
    <p>
      {credential.issuer}
      <time class="course-date" datetime={credential.issued}>
        {formatDate(credential.issued, locale)}
      </time>
    </p>
  </div>
</li>
