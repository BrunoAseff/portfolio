---
import type { Locale, Project } from "../../content/types";
import { messages } from "../../content/messages";
import Icon from "../../components/ui/Icon.astro";
import ExternalLink from "../../components/ui/ExternalLink.astro";
import ProjectMedia from "./ProjectMedia.astro";
interface Props {
  locale: Locale;
  project: Project;
}
const { locale, project } = Astro.props,
  c = messages[locale];
---

<article class="project" id={`projeto-${project.id}`}>
  <div class="project-heading">
    <h3>
      {project.links.website ? (
        <ExternalLink class="project-name" href={project.links.website}>
          <span class="link-label">{project.name}</span>
          <Icon name="external" />
        </ExternalLink>
      ) : (
        project.name
      )}
    </h3>
  </div>
  {project.content[locale].pitch && <p class="project-pitch">{project.content[locale].pitch}</p>}
  <ProjectMedia project={project} locale={locale} />
  {project.content[locale].paragraphs.length > 0 && (
    <div class="prose">
      {project.content[locale].paragraphs.map((p) => (
        <p>{p}</p>
      ))}
    </div>
  )}
  <div class="project-actions attention-group">
    {project.links.repository && (
      <ExternalLink class="text-link" href={project.links.repository}>
        <span class="link-label">{c.code}</span>
        <Icon name="code" />
      </ExternalLink>
    )}
  </div>
</article>
