---
import type { Locale } from "../../content/types";
import { profile } from "../../content/profile";
import { messages } from "../../content/messages";
import { site } from "../../content/site";
import LanguageSwitcher from "../../components/LanguageSwitcher.astro";
import SoundToggle from "../sound/SoundToggle.astro";
import ResumeControl from "../../components/ui/ResumeControl";
import ExperienceDuration from "./ExperienceDuration.astro";
interface Props {
  locale: Locale;
}
const { locale } = Astro.props,
  c = messages[locale],
  p = profile[locale];
---

<header id="inicio" class="introduction">
  <div class="masthead">
    <h1>{site.name}</h1>
    <div class="utilities">
      <LanguageSwitcher locale={locale} />
      <SoundToggle locale={locale} />
    </div>
  </div>
  <div class="profile-copy">
    <p class="role">{p.role}</p>
    <p class="intro-copy">{p.intro}</p>
    <p class="personal-meta">
      <span>{p.location}</span>
      <ExperienceDuration locale={locale} />
    </p>
  </div>
  <div class="intro-actions">
    <ResumeControl locale={locale} client:load />
  </div>
  <div class="orientation">
    <nav class="index" aria-label={c.navigation}>
      {c.sections.slice(1).map((section, index) => (
        <a href={`#${section.id}`} data-sound="tap">
          <span>{section.name}</span>
          {index < 3 && (
            <span class="nav-separator" aria-hidden="true">
              /
            </span>
          )}
        </a>
      ))}
    </nav>
  </div>
</header>
