---
import { site } from "../content/site";
import { profile } from "../content/profile";
import { localePath, htmlLanguage } from "../lib/locale";
import type { Locale } from "../content/types";
interface Props {
  locale: Locale;
  notFound?: boolean;
}
const { locale, notFound = false } = Astro.props;
const noindex = notFound || process.env.SITE_NOINDEX === "1";
const url = new URL(localePath(locale), site.url).href;
const title = notFound
  ? locale === "pt"
    ? "Página não encontrada"
    : "Page not found"
  : `${site.name} — ${profile[locale].role}`;
const description = profile[locale].intro;
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "ProfilePage",
  "@id": `${url}#profile`,
  url,
  inLanguage: htmlLanguage(locale),
  mainEntity: {
    "@type": "Person",
    "@id": `${site.url}/#person`,
    name: site.name,
    url: site.url,
    jobTitle: profile[locale].role,
    sameAs: [site.github, site.linkedin],
  },
};
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<title>{title}</title>
<meta name="description" content={description} />
<meta name="theme-color" content="#fcfcfa" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
{noindex && <meta name="robots" content="noindex,follow" />}
{!notFound && (
  <>
    <link rel="canonical" href={url} />
    <link rel="alternate" hreflang="pt-BR" href={`${site.url}/`} />
    <link rel="alternate" hreflang="en" href={`${site.url}/en/`} />
    <link rel="alternate" hreflang="x-default" href={`${site.url}/`} />
  </>
)}
<meta property="og:type" content="website" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={url} />
<meta property="og:locale" content={locale === "pt" ? "pt_BR" : "en_US"} />
<meta property="og:locale:alternate" content={locale === "pt" ? "en_US" : "pt_BR"} />
<meta property="og:site_name" content={site.name} />
<meta property="og:image" content={`${site.url}/social/profile-${locale}.png`} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={`${site.name} — ${profile[locale].role}`} />
<meta name="twitter:card" content="summary_large_image" />
{!notFound && (
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd).replace(/</g, "\u003c")} />
)}
