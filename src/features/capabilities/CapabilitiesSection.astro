---
import { profile } from "../../content/profile";
import { messages } from "../../content/messages";
import type { Locale } from "../../content/types";
import TechnologyList from "./TechnologyList.astro";
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
---

<section id="conhecimentos" aria-labelledby="knowledge-title" tabindex="-1">
  <h2 id="knowledge-title" class="section-title">
    {messages[locale].sections[0].name}
  </h2>
  <dl class="knowledge">
    {profile[locale].deliveries.map(([title, description]) => (
      <div>
        <dt>{title}</dt>
        <dd>{description}</dd>
      </div>
    ))}
  </dl>
  <TechnologyList locale={locale} />
</section>
