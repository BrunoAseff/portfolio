---
import { paths, type IconName } from "./icon-paths";
interface Props {
  name: Exclude<IconName, "sound" | "check">;
}
const { name } = Astro.props;
---

<svg
  class={`icon icon-${name}`}
  width="20"
  height="20"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  {paths[name].map((d) => (
    <path d={d} />
  ))}
</svg>
