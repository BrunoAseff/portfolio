---
import type { Locale } from "../content/types";
import { messages } from "../content/messages";
import SiteLayout from "../layouts/SiteLayout.astro";
import Landscape from "../components/Landscape.astro";
import Introduction from "../features/introduction/Introduction.astro";
import CapabilitiesSection from "../features/capabilities/CapabilitiesSection.astro";
import ExperienceSection from "../features/experience/ExperienceSection.astro";
import ProjectsSection from "../features/projects/ProjectsSection.astro";
import EducationSection from "../features/education/EducationSection.astro";
import ContactSection from "../features/contact/ContactSection.astro";
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
---

<SiteLayout locale={locale}>
  <div class="portfolio direction-serra">
    <a class="skip" href="#main">
      {messages[locale].skip}
    </a>
    <Landscape />
    <div class="reading-column">
      <Introduction locale={locale} />
      <main id="main" tabindex="-1">
        <CapabilitiesSection locale={locale} />
        <ExperienceSection locale={locale} />
        <ProjectsSection locale={locale} />
        <EducationSection locale={locale} />
        <ContactSection locale={locale} />
      </main>
    </div>
  </div>
</SiteLayout>
